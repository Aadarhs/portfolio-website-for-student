# Contact Form Configuration
# Choose one email service and fill in the corresponding variables

# === Resend (Recommended) ===
# Sign up at: https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === SendGrid ===
# Sign up at: https://sendgrid.com
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Mailgun ===
# Sign up at: https://www.mailgun.com
# MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MAILGUN_DOMAIN=mg.example.com

# === SMTP (Gmail, Outlook, etc.) ===
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your.email@gmail.com
# SMTP_PASS=your_app_password

# Contact form settings
CONTACT_EMAIL=your.email@example.com
CONTACT_API_KEY=your_secure_api_key_optional

# === Database Options ===

# Supabase (if using Supabase)
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Cloudflare D1 (if using D1 database)
# D1_DATABASE_ID=your-database-id

# === OAuth & Authentication ===
# If implementing GitHub OAuth or other auth methods
# GITHUB_CLIENT_ID=xxxxxxxxxxxxxxxxxxxx
# GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxx

# === API Keys ===
# Add any additional API keys needed for your portfolio
